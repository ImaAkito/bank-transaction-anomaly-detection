# Docker Compose (значения по умолчанию подходят для демонстрации; для реального использования смените пароли и секреты)
POSTGRES_USER=anomaly
POSTGRES_PASSWORD=anomaly
POSTGRES_DB=anomaly
LOG_LEVEL=INFO
AUTH_ENABLED=true
AUTH_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
INGEST_API_KEY=demo-ingest-key
DEFAULT_TIMEZONE=Europe/Minsk
QUEUE_PARTITIONS=4
RETRAIN_INTERVAL_HOURS=24
RETRAIN_CHECK_MINUTES=30
SIM_CLIENTS=40
SIM_RATE=4
# Порты на компьютере: поменяйте, если 8080 или 8000 уже заняты другой программой
FRONTEND_PORT=8080
API_PORT=8000

# Локальный запуск без Docker (backend/.env)
# DATABASE_URL=sqlite:///./data/app.db
# QUEUE_BACKEND=memory
# MODEL_PATH=models/model.joblib
# AUTH_ENABLED=false
